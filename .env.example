PORT=4000

# Postgres connection
DATABASE_URL=postgres://user:password@host:port/dbname

# Redis connection
REDIS_URL=redis://127.0.0.1:6379

# Network RPC URLs (optional — public fallbacks are used when not set)
AMOY_RPC_URL=https://your-amoy-rpc-url
FUJI_RPC_URL=https://your-fuji-rpc-url
OPSEPOLIA_RPC_URL=https://your-opsepolia-rpc-url
BNBTESTNET_RPC_URL=https://your-bnbtestnet-rpc-url
SEPOLIA_RPC_URL=https://your-sepolia-rpc-url
CELO_SEPOLIA_RPC_URL=https://your-celo-sepolia-rpc-url
BASESEPOLIA_RPC_URL=https://your-basesepolia-rpc-url

# Kalp credentials for Production environment
PROD_KALP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
PROD_KALP_ENROLLMENT_ID=your_prod_enrollment_id
PROD_KALP_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Kalp credentials for Development environment
DEV_KALP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
DEV_KALP_ENROLLMENT_ID=your_dev_enrollment_id
DEV_KALP_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Kalp credentials for Staging environment
STAGE_KALP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
STAGE_KALP_ENROLLMENT_ID=your_stage_enrollment_id
STAGE_KALP_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
